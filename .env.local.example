# --- Sanity ---
# Create a project at https://www.sanity.io/manage, then fill these in.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-06-01

# Server-only token with "Editor" access, used by API routes that write to
# Sanity (register/subscribe forms) and by the webhook handler.
# Create at https://www.sanity.io/manage → API → Tokens.
SANITY_API_TOKEN=

# Signing secret for the Sanity → Next.js webhook (Studio → API → Webhooks).
# Any random string; must match what you enter in the Sanity webhook config.
SANITY_WEBHOOK_SECRET=

# --- Resend (email) ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Must be on a domain verified in Resend.
RESEND_FROM_EMAIL="MMSPL <no-reply@mmspl.ca>"
# Where contact form submissions are sent.
MMSPL_ADMIN_EMAIL=info@mmspl.ca

# --- Web Push (browser push notifications, /notifications page) ---
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:info@mmspl.ca"

# --- Admin score entry (/admin) ---
# Any password you choose. The login session is a signed cookie valid for
# the calendar day it was issued — no separate session store needed.
ADMIN_PASSWORD=
